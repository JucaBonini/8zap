# Porta onde o servidor Express vai rodar
PORT=3000

# Chave secreta de autenticação para a API (enviada no header 'x-api-key')
API_KEY=sua_chave_secreta_aqui_12345

# Intervalo em segundos para checagem da fila de agendamentos
INTERVALO_AGENDADOR_SEGUNDOS=60

# Intervalo em minutos para atualização automática dos feeds RSS
INTERVALO_RSS_MINUTOS=30

# Delay mínimo entre envios da mesma sessão em milissegundos (rate limiting)
DELAY_ENTRE_ENVIOS_MS=1500

# Chaves de API das IAs (Opcional - podem ser configuradas no painel web ou aqui globalmente)
OPENAI_API_KEY=sk-proj-sua_chave_openai_aqui
GEMINI_API_KEY=AIzaSy_sua_chave_gemini_aqui
